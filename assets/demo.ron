// runt demo scene — save-as-params (DESIGN §6).
//
// Two lists. `generators` says what to build; `entities` says where to put it.
// Nothing here is baked: every mesh below is regenerated from these numbers on
// load, resolved through the content cache, and keyed by the hash of what it
// produced. Edit a number, run, see it.
//
// The `ball` generator is referenced by *two* entities. That is deliberate: the
// second one differs only in transform and material, so both resolve to the same
// content hash and the renderer uploads one pair of buffers for the pair. If you
// want two visually different spheres, change the generator — placement is not
// shape.
(
    generators: [
        // The ground is an analytic height field (DESIGN §9), not a mesh with
        // collision baked into it. What you see is a tessellation of h(x, z);
        // physics samples the same h directly, so the surface the ball rolls on
        // is the surface you are looking at at every quality tier.
        (
            name: "ground",
            spec: Terrain((
                seed: 20260731,
                size: (40.0, 40.0),
                amplitude: 1.2,
                octaves: 4,
                frequency: 0.055,
                lacunarity: 2.0,
                gain: 0.5,
                base_segments: 64,
                // `tint` supersedes the flat `color` this patch used to carry.
                // Every stop is read from the analytic field (height + gradient),
                // never from the meshed lattice, so the colouring is the same at
                // every quality tier — the §9 rule applied to shading.
                //
                // Kept deliberately close to the old flat 0.17/0.21/0.18: the
                // demo is a lighting and dedup showcase, and a technicolor ground
                // would fight the props it exists to show off. The band is
                // normalised by `amplitude` (1.2), which is a bound rather than
                // a tight range, so real ground lands around t = 0.2..0.8 of it.
                tint: Some((
                    low_color: (0.14, 0.20, 0.15),   // moss, in the hollows
                    high_color: (0.34, 0.32, 0.24),  // dry grass on the crests
                    steep_color: (0.24, 0.22, 0.20), // grey-brown where it falls away
                    steep_start_deg: 20.0,
                    steep_full_deg: 38.0,
                )),
            )),
        ),
        (
            name: "ball",
            spec: UvSphere(
                radius: 0.9,
                rings: 24,
                sectors: 32,
                shading: Smooth(180.0),
                color: Some((0.90, 0.35, 0.35)),
            ),
        ),
        (
            name: "post",
            spec: Cylinder(
                radius: 0.35,
                height: 1.8,
                segments: 24,
                color: Some((0.35, 0.55, 0.95)),
            ),
        ),
        (
            name: "spike",
            spec: Cone(
                radius: 0.6,
                height: 1.4,
                segments: 20,
                color: Some((0.95, 0.80, 0.30)),
            ),
        ),
        (
            name: "ring",
            spec: Torus(
                major_radius: 0.7,
                minor_radius: 0.22,
                major_segments: 32,
                minor_segments: 16,
                color: Some((0.55, 0.85, 0.55)),
            ),
        ),
        // Stretch, twist and taper are *shape*: they change the geometry, so
        // they belong in the generator and legitimately change the content hash.
        // A placement `scale` would not.
        (
            name: "twisted_box",
            spec: TwistedBox(
                dims: (1.0, 1.6, 1.0),
                twist: 0.9,
                taper: 0.4,
                shading: Flat,
                color: Some((0.80, 0.45, 0.90)),
            ),
        ),
    ],

    entities: [
        // Dropped just far enough that the props rest on the high ground rather
        // than in it: with this seed the field peaks at ~+0.72 under their
        // footprints, so -2.0 leaves every underside about 0.14 clear.
        // `tests/scene.rs` asserts that, so a seed change fails loudly instead
        // of quietly burying the spike.
        // Translation only — a rotated height field is not a height field.
        (
            name: Some("ground"),
            generator: "ground",
            transform: (translation: (0.0, -2.0, 0.0)),
        ),
        (
            name: Some("ball"),
            generator: "ball",
            transform: (translation: (-1.9, -0.3, 0.0)),
        ),
        (
            name: Some("post"),
            generator: "post",
            transform: (translation: (0.0, -0.3, -1.6)),
        ),
        (
            name: Some("spike"),
            generator: "spike",
            transform: (translation: (1.9, -0.5, 0.0)),
        ),
        (
            name: Some("ring"),
            generator: "ring",
            // Degrees, applied X→Y→Z: stood upright, facing the camera.
            transform: (
                translation: (0.0, 0.4, 1.7),
                rotation: Euler((90.0, 0.0, 0.0)),
            ),
        ),
        // The dedup twin: same generator as "ball", half the size from the
        // *transform*, and a flat material that ignores the mesh's vertex
        // colors — which also means a second shader variant and a second
        // pipeline. One mesh, two looks.
        (
            name: Some("ball_twin"),
            generator: "ball",
            transform: (
                translation: (-2.0, 0.5, 1.9),
                scale: (0.5, 0.5, 0.5),
            ),
            material: (
                base_color: (0.35, 0.75, 0.95, 1.0),
                vertex_color: false,
            ),
        ),
        // The one moving piece. `Interpolated` is implied by `spin`.
        (
            name: Some("spinner"),
            generator: "twisted_box",
            transform: (translation: (0.0, 0.5, 0.0)),
            spin: Some((axis: (0.0, 1.0, 0.0), rad_per_sec: 0.4)),
        ),
    ],

    camera: (
        eye: (0.0, 2.4, 6.5),
        target: (0.0, 0.0, 0.0),
        fov_y_degrees: 60.0,
        z_near: 0.1,
        z_far: 100.0,
        // The spinner does not translate, so the follow reads as a soft settle
        // over the first second and a rock-steady frame afterwards.
        follow: Some((
            entity: "spinner",
            offset: (0.0, 1.9, 6.5),
            stiffness: 2.0,
        )),
    ),

    // The same three ambient colours light the surfaces *and* paint the
    // background gradient (DESIGN §5): sky at the zenith, ground at the nadir,
    // `horizon` where the view ray is level. Omitting `horizon` takes the
    // sky/ground midpoint, which is what every scene written before the sky
    // existed gets; this one names a slightly warmer, brighter band so the dark
    // props have something to read against.
    lighting: (
        key_dir: (0.4, 1.0, 0.6),
        key_color: (0.74, 0.72, 0.68),
        sky_color: (0.30, 0.33, 0.40),
        ground_color: (0.14, 0.13, 0.12),
        horizon: Some((0.34, 0.31, 0.30)),
    ),
)
